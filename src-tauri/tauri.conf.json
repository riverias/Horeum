{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horeum",
  "version": "1.0.0",
  "identifier": "app.horeum.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Horeum",
        "width": 1400,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 660,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© Horeum",
    "category": "Music",
    "shortDescription": "Horeum music player",
    "longDescription": "Horeum — modern desktop music player with SoundCloud streaming, synced lyrics, moods, wave radio and profile leveling."
  }
}
